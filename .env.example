# insomniaXXX - configurable application environment
# Copy this file to .env and edit for your environment:
#   cp .env.example .env
# `make run` loads .env automatically; Docker requires --env-file .env.
# Never commit .env with real deployment secrets or private endpoints.
#
# These are ALL application-specific environment variables currently read
# by the Go server. Other settings (OnionGuard wait/CAPTCHA parameters, RLNC
# coding profile, cache TTL, edge rate limits) are NOT configurable via .env.
#
# PRODUCTION: set APP_ENV=production, replace PUBLIC_BASE_URL with your REAL
# canonical public origin, and configure at least two independent and trusted
# Blossom relays. See README.md#production-deployment-checklist.

# ---------------------------------------------------------------------------
# Application mode
# ---------------------------------------------------------------------------
# "production" enables additional startup validation:
#   - PUBLIC_BASE_URL is required;
#   - HTTPS is required, except for a native HTTP .onion origin;
#   - at least two distinct Blossom URLs must be configured.
# "development" is convenient locally and does NOT enforce these prod checks.
APP_ENV=development

# ---------------------------------------------------------------------------
# Public origin and server listener
# ---------------------------------------------------------------------------
# Public base URL used in share links. Replace this example with your real
# public origin BEFORE deploying. Origin only: no path, query, credentials
# or fragment. HTTPS is required in production except for native HTTP .onion.
PUBLIC_BASE_URL=https://files.example.com

# Address on which the Go HTTP server listens. :8080 listens on all interfaces.
# If changed in Docker, also adjust the container port mapping/proxy.
# Do not expose the app directly to the Internet; use a reverse proxy.
LISTEN_ADDR=:8080

# ---------------------------------------------------------------------------
# Storage: Blossom relay URLs
# ---------------------------------------------------------------------------
# Comma-separated HTTP(S) origins for opaque application/octet-stream blobs.
# Files and RLNC shards require at least two successful distinct relay copies.
# The examples below are PUBLIC relays, not audited or guaranteed durable.
# Replace them with trusted, independent relays for production. Relays may
# inspect network metadata; encrypted blobs cannot be revoked after upload.
BLOSSOM_URLS=https://cdn.hzrd149.com,https://nostr.download,https://blossom.poster.place,https://cdn.sovbit.host

# ---------------------------------------------------------------------------
# Upload and memory controls
# ---------------------------------------------------------------------------
# Maximum accepted plaintext upload size, in BYTES.
# Default: 19922944 (19 MiB). Allowed range: 1 to 67108864 (64 MiB).
# Encrypted output and RLNC overhead can require additional memory and disk.
MAX_UPLOAD_BYTES=19922944

# Size of encryption chunks in BYTES.
# Default: 1048576 (1 MiB). Allowed: 65536 (64 KiB) to 8388608 (8 MiB).
CHUNK_SIZE=1048576

# Number of concurrent uploads. Default: 2. Allowed: 1 to 4.
# Separate fixed server limits apply to expensive RLNC uploads/downloads.
UPLOAD_CONCURRENCY=2

# ---------------------------------------------------------------------------
# OnionGuard session cookie
# ---------------------------------------------------------------------------
# Boolean: true/false (also accepts 1/0, yes/no, on/off).
# Must be true when PUBLIC_BASE_URL uses HTTPS.
# Set false ONLY for a native HTTP .onion service.
ONIONGUARD_COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Optional display version
# ---------------------------------------------------------------------------
# An optional version label displayed in the UI. Empty = automatic.
# A version compiled into the binary using Go -ldflags takes precedence,
# so this variable cannot override the official GitHub release build tag.
APP_VERSION=
