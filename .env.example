# Public Blossom instances used for generic blob storage.
# These defaults are chosen for generic Blossom/nsite-style blobs, not media-only hosts.
# Uploads are attempted against every listed server for redundancy.
# Downloads try them in order until the blob is found.
BLOSSOM_URLS=https://cdn.hzrd149.com,https://nostr.download,https://blossom.poster.place,https://cdn.sovbit.host

# Strongly recommended when running behind a reverse proxy.
PUBLIC_BASE_URL=https://files.example.com

LISTEN_ADDR=:8080
# Maximum accepted value is 67108864 (64 MiB); encrypted objects get 4 MiB overhead.
MAX_UPLOAD_BYTES=19922944
CHUNK_SIZE=1048576
# Values above 4 are rejected to keep memory/CPU use bounded.
UPLOAD_CONCURRENCY=2

# OnionGuard protects the HTTP app with a zero-JS wait room + CAPTCHA.
# Set true when the app is behind HTTPS; keep false for a native .onion HTTP service.
ONIONGUARD_COOKIE_SECURE=true

# Upload authorization is generated ephemerally per Blossom instance and blob.
